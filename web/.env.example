# Copier en web/.env.local (ignoré par git). Ne jamais commiter de .env réel.
# Config Firebase web (non secrète, mais gardée hors du dépôt public) — console Firebase > Paramètres du projet.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=dashboard-ydash.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=dashboard-ydash
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# URL de base des Cloud Functions (vide = émulateur local).
VITE_API_BASE=
# Chemin de publication : / en local, /ydash/ en prod, /ydash/staging/ en staging.
VITE_BASE=/
# Environnement logique : local | staging | prod
VITE_YDASH_ENV=local
# true = brancher l'app sur les émulateurs Firebase (npm run dev:full)
VITE_USE_EMULATORS=false
