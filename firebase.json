{
  "functions": [
    {
      "source": "functions/lib/prod",
      "codebase": "prod",
      "runtime": "nodejs22",
      "predeploy": ["npm run build -w functions"]
    },
    {
      "source": "functions/lib/stg",
      "codebase": "stg",
      "runtime": "nodejs22",
      "predeploy": ["npm run build -w functions"]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "singleProjectMode": true,
    "auth": {
      "host": "127.0.0.1",
      "port": 9099
    },
    "functions": {
      "host": "127.0.0.1",
      "port": 5001
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 8080
    },
    "ui": {
      "enabled": true,
      "host": "127.0.0.1",
      "port": 4000
    }
  }
}
