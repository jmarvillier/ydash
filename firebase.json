{
  "functions": [
    {
      "source": "functions/lib/prod",
      "codebase": "prod",
      "runtime": "nodejs22",
      "predeploy": ["npm run build -w functions"]
    },
    {
      "source": "functions/lib/stg",
      "codebase": "stg",
      "runtime": "nodejs22",
      "predeploy": ["npm run build -w functions"]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
