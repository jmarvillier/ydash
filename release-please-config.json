{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "bump-minor-pre-major": false,
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Fonctionnalités"
    },
    {
      "type": "fix",
      "section": "Corrections"
    },
    {
      "type": "perf",
      "section": "Performance"
    },
    {
      "type": "refactor",
      "section": "Refactoring"
    },
    {
      "type": "docs",
      "section": "Documentation"
    },
    {
      "type": "ci",
      "section": "CI/CD"
    },
    {
      "type": "chore",
      "section": "Maintenance",
      "hidden": true
    },
    {
      "type": "test",
      "section": "Tests",
      "hidden": true
    },
    {
      "type": "build",
      "section": "Build",
      "hidden": true
    }
  ],
  "packages": {
    ".": {
      "package-name": "ydash",
      "changelog-path": "CHANGELOG.md",
      "versioning": "prerelease",
      "prerelease": true,
      "prerelease-type": "alpha",
      "extra-files": [
        {
          "type": "json",
          "path": "core/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "web/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "functions/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "package-lock.json",
          "jsonpath": "$.packages.core.version"
        },
        {
          "type": "json",
          "path": "package-lock.json",
          "jsonpath": "$.packages.web.version"
        },
        {
          "type": "json",
          "path": "package-lock.json",
          "jsonpath": "$.packages.functions.version"
        }
      ],
      "release-as": "2.0.0-alpha.1"
    }
  }
}
