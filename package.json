{
  "name": "ydash",
  "version": "2.0.0-alpha.0",
  "private": true,
  "description": "Ydash v2 — dashboard de trading crypto personnel branché sur OKX",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "workspaces": [
    "core",
    "web",
    "functions"
  ],
  "scripts": {
    "dev": "npm run build -w functions && concurrently -n emu,fn,web,seed -c yellow,magenta,cyan,green \"npm:emulators\" \"npm:dev -w functions\" \"npm:dev:web:emu\" \"npm:seed:wait\"",
    "dev:web": "npm run dev -w web --",
    "dev:web:emu": "VITE_USE_EMULATORS=true VITE_YDASH_ENV=local VITE_API_BASE=http://127.0.0.1:5001/demo-ydash/europe-west1/stg- npm run dev -w web",
    "emulators": "firebase emulators:start --project demo-ydash",
    "seed": "GCLOUD_PROJECT=demo-ydash tsx tools/seed-demo.ts",
    "seed:wait": "wait-on -t 180000 tcp:127.0.0.1:8080 tcp:127.0.0.1:9099 && npm run seed",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p tools",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "3.2.7",
    "concurrently": "9.2.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.26",
    "firebase-tools": "15.34.2",
    "globals": "15.15.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "3.2.7",
    "wait-on": "8.0.5"
  },
  "overrides": {
    "vite": "6.4.5"
  }
}
