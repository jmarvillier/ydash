# Copier en functions/.env.local pour l'émulateur (ignoré par git).
# Aucune clé OKX ici : elles vivent dans Secret Manager, une par utilisateur (ticket C03).

# prod | stg — choisit la collection racine Firestore (ydash_v2 / ydash_v2_stg).
YDASH_ENV=stg
# Host API OKX du compte EEA.
OKX_BASE_URL=https://eea.okx.com
# true = les appels OKX sont servis par les fixtures JSON (functions/fixtures/okx) — dev local et tests.
OKX_MOCK=true
