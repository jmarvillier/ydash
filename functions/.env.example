# Copier en functions/.env.local pour l'émulateur (ignoré par git ; recopié dans lib/<env>/ au build).
# Aucune clé OKX ici : elles vivent dans Secret Manager, une par utilisateur (ticket C03).

# prod | stg — choisit la collection racine Firestore (ydash_v2 / ydash_v2_stg).
YDASH_ENV=stg
# Host API OKX du compte EEA.
OKX_BASE_URL=https://eea.okx.com
# true = appels OKX servis par les fixtures JSON (functions/fixtures/okx). Par défaut : true dans l'émulateur.
OKX_MOCK=true
